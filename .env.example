# Application Settings
APP_NAME=File Import Service
APP_VERSION=1.0.0
APP_DESCRIPTION=API for importing files via URIs and retrieving them

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# API Settings
API_PREFIX=

# CORS Settings
ALLOW_ORIGINS=["*"]
ALLOW_CREDENTIALS=True
ALLOW_METHODS=["*"]
ALLOW_HEADERS=["*"]

# Storage Settings
STORAGE_TYPE=memory
MAX_FILE_SIZE_MB=100

# Database Settings (for future use)
# DATABASE_URL=postgresql://user:password@localhost/dbname
